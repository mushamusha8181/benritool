<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="便利ツール"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="6dp"
            android:text="毎日使えるシンプルな道具箱"
            android:textColor="@color/subtext"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/favoriteTitle"
            style="@style/SectionTitle"
            android:text="お気に入り"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView style="@style/SectionTitle" android:text="ライト" />
        <Button android:id="@+id/btnTorch" style="@style/ToolButton" android:text="🔦  ライト  OFF" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">
            <Button android:id="@+id/btnWeak" style="@style/SmallButton" android:text="弱" />
            <Button android:id="@+id/btnMedium" style="@style/SmallButton" android:text="中" />
            <Button android:id="@+id/btnStrong" style="@style/SmallButton" android:text="強" />
        </LinearLayout>
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">
            <Button android:id="@+id/btnScreenLight" style="@style/GridToolButton" android:text="☀️ 画面ライト" />
            <Button android:id="@+id/btnBlink" style="@style/GridToolButton" android:text="✨ 点滅ライト" />
        </GridLayout>

        <TextView style="@style/SectionTitle" android:text="測る" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
            <Button android:id="@+id/btnCompass" style="@style/GridToolButton" android:text="🧭 コンパス" />
            <Button android:id="@+id/btnRuler" style="@style/GridToolButton" android:text="📏 定規" />
            <Button android:id="@+id/btnLevel" style="@style/GridToolButton" android:text="⚖️ 水平器" />
            <Button android:id="@+id/btnMagnetic" style="@style/GridToolButton" android:text="🧲 磁気メーター" />
        </GridLayout>

        <TextView style="@style/SectionTitle" android:text="カメラ・読み取り" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
            <Button android:id="@+id/btnMagnifier" style="@style/GridToolButton" android:text="🔎 拡大鏡" />
            <Button android:id="@+id/btnQr" style="@style/GridToolButton" android:text="▣ QR・バーコード" />
            <Button android:id="@+id/btnOcr" style="@style/GridToolButton" android:text="🔤 文字読み取り" />
            <Button android:id="@+id/btnColorPicker" style="@style/GridToolButton" android:text="🎨 色を調べる" />
        </GridLayout>

        <TextView style="@style/SectionTitle" android:text="作る・変換" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
            <Button android:id="@+id/btnQrMaker" style="@style/GridToolButton" android:text="⊞ QR作成" />
            <Button android:id="@+id/btnWifiQr" style="@style/GridToolButton" android:text="📶 Wi-Fi QR" />
            <Button android:id="@+id/btnShortUrl" style="@style/GridToolButton" android:text="🔗 短縮URL" />
            <Button android:id="@+id/btnUnit" style="@style/GridToolButton" android:text="↔️ 単位変換" />
            <Button android:id="@+id/btnTextTools" style="@style/GridToolButton" android:text="✍️ 文字ツール" />
            <Button android:id="@+id/btnRandom" style="@style/GridToolButton" android:text="🎲 乱数・くじ" />
        </GridLayout>

        <TextView style="@style/SectionTitle" android:text="その他" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
            <Button android:id="@+id/btnTimer" style="@style/GridToolButton" android:text="⏱️ タイマー" />
            <Button android:id="@+id/btnCounter" style="@style/GridToolButton" android:text="🔢 カウンター" />
            <Button android:id="@+id/btnDeviceInfo" style="@style/GridToolButton" android:text="📱 端末情報" />
            <Button android:id="@+id/btnFavorites" style="@style/GridToolButton" android:text="⭐ お気に入り編集" />
            <Button android:id="@+id/btnSystemCheck" style="@style/GridToolButton" android:text="🛡️ 権限確認" />
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="※ 基本機能は端末内で動作。短縮URL作成時のみ、確認後に入力URLをis.gdへ送信します。"
            android:textColor="@color/subtext"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
