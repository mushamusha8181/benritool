        android:icon="@drawable/ic_app"
        android:shortcutShortLabel="@string/shortcut_qr_short"
        android:shortcutLongLabel="@string/shortcut_qr_long">
        <intent
            android:action="jp.mushamusha.utilitylight.action.SCAN_QR"
            android:targetPackage="jp.mushamusha.utilitylight"
            android:targetClass="jp.mushamusha.utilitylight.MainActivity" />
