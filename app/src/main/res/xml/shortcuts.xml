        android:shortcutId="torch_on"
        android:enabled="true"
        android:icon="@drawable/ic_app"
        android:shortcutShortLabel="@string/shortcut_torch_short"
        android:shortcutLongLabel="@string/shortcut_torch_long">
        <intent
            android:action="jp.mushamusha.utilitylight.action.TORCH_ON"
            android:targetPackage="jp.mushamusha.utilitylight"
